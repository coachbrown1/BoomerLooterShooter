[gd_scene load_steps=5 format=3]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_expl"]
transparency = 1
blend_mode = 1
shading_mode = 0
albedo_color = Color(3, 1.5, 0.2, 1)

[sub_resource type="SphereMesh" id="SphereMesh_expl"]
material = SubResource("StandardMaterial3D_expl")

[sub_resource type="GDScript" id="GDScript_expl"]
script/source = "extends Node3D
func _ready():
	$Mesh.material_override = $Mesh.material_override.duplicate()
	var tween = create_tween()
	# Expand sphere rapidly
	tween.tween_property($Mesh, \"scale\", Vector3(8.0, 8.0, 8.0), 0.25).set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_OUT)
	# Fade out color
	tween.parallel().tween_property($Mesh.material_override, \"albedo_color:a\", 0.0, 0.3)
	# Fade light
	tween.parallel().tween_property($Light, \"light_energy\", 0.0, 0.4)
	
	tween.finished.connect(queue_free)
"

[node name="FireballExplosion" type="Node3D"]
script = SubResource("GDScript_expl")

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("SphereMesh_expl")
material_override = SubResource("StandardMaterial3D_expl")

[node name="Light" type="OmniLight3D" parent="."]
light_color = Color(1, 0.6, 0.1, 1)
light_energy = 8.0
omni_range = 15.0
